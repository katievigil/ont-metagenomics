/*
 * Configuration for the ONT metagenomics pipeline.
 * Choose one execution profile: -profile conda | docker | singularity | wave
 */

params {
    help              = false
    samplesheet       = null
    outdir            = 'results'

    // Read filtering (app note: Samtools mean read quality >= 10, read length >= 1 kb)
    min_qual          = 10
    min_len           = 1000

    // Basecalling, only for runs given as POD5 directories (app note: SUP v5.0.0 + 6mA + 4mC_5mC)
    dorado_model      = 'sup@v5.0.0,6mA,4mC_5mC'
    dorado_device     = 'cuda:all'
    dorado_container  = 'nanoporetech/dorado:latest'   // pin a version tag for reproducible runs

    // Contig assessment and binning
    large_contig_size = 1000000     // contigs >= this size are assessed individually (SC HQ MAGs)
    semibin_env       = 'human_gut'
    semibin_min_len   = 10000
    metabat_min_len   = 30000

    // MAG criteria (CheckM2)
    sc_hq_linear_completeness   = 95
    sc_hq_circular_completeness = 90
    hq_completeness   = 90
    hq_contamination  = 5
    mq_completeness   = 50
    mq_contamination  = 10

    // Reference databases
    checkm2_db        = null        // required: CheckM2 database directory
    gtdbtk_db         = null        // required: GTDB R220 reference data for GTDB-Tk
    viralverify_hmm   = null        // required: viralVerify HMM file (nbc_hmms.hmm)
    amrfinder_db      = null        // optional: defaults to the AMRFinderPlus installed database
}

manifest {
    name            = 'katievigil/ont-metagenomics'
    description     = 'Nanopore metagenomics: metaMDBG assembly, MAG recovery and AMR localisation (after ONT application note AN_1282)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '1.0.0'
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_low    { cpus = 4;  memory = '8 GB';    time = '4h'  }
    withLabel: process_medium { cpus = 16; memory = '64 GB';   time = '24h' }
    withLabel: process_high   { cpus = 32; memory = '256 GB';  time = '72h' }
    withLabel: gpu            { cpus = 8;  memory = '32 GB';   time = '72h'; accelerator = 1 }
}

profiles {
    conda {
        conda.enabled          = true
    }
    docker {
        docker.enabled         = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    wave {
        // Builds a container on the fly from each process's conda directive
        wave.enabled           = true
        wave.freeze            = true
        conda.enabled          = true
        docker.enabled         = true
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
